# Copy to .env for local testing (gitignored). In CI these are GitHub Secrets.
# All optional — code falls back to the values baked into src/config.js.

# Set true to actually send commands; false = read-only / dashboard only.
CONTROL_ENABLED=false

# GoodWe / SEMS portal
SEMS_ACCOUNT=
SEMS_PASSWORD=
SEMS_STATION_ID=

# MSpa
MSPA_APP_ID=
MSPA_APP_SECRET=
MSPA_ACCOUNT=
MSPA_PASS_MD5=
MSPA_DEVICE_ID=
MSPA_PRODUCT_ID=

# Toshiba
TOSHIBA_USER=
TOSHIBA_PASS=
TOSHIBA_CLIENT_ID=
TOSHIBA_AC_UNIQUE_ID=
